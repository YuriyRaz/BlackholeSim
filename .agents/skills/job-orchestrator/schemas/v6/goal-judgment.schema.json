{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Judge decision record v6",
  "type": "object",
  "required": ["schema_version", "judgment_id", "goal_gate_id", "run_id", "cycle_id", "graph_revision", "producer_job_id", "decision", "evidence_refs", "reason", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "judgment_id": {"$ref": "#/$defs/id"},
    "goal_gate_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "producer_job_id": {"$ref": "#/$defs/id"},
    "decision": {"type": "string", "enum": ["GOAL_ACHIEVED", "CONTINUE", "BLOCKED", "INFEASIBLE", "BLOCKED_NO_PROGRESS", "BUDGET_EXHAUSTED"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"}, "uniqueItems": true},
    "reason": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
