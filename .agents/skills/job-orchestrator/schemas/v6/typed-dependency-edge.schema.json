{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed dependency edge v6",
  "type": "object",
  "required": ["schema_version", "edge_id", "source_job_id", "target_job_id", "edge_type", "graph_revision", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "edge_id": {"$ref": "#/$defs/id"},
    "source_job_id": {"$ref": "#/$defs/id"},
    "target_job_id": {"$ref": "#/$defs/id"},
    "edge_type": {"type": "string", "enum": ["success", "execution", "all-settled", "report", "verification", "batch", "cycle"]},
    "graph_revision": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
