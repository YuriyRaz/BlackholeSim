{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context snapshot with versions and digests v6",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "run_id", "cycle_id", "graph_revision", "versions", "digest", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "versions": {"$ref": "#/$defs/snapshot_versions"},
    "digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "snapshot_versions": {
      "type": "object",
      "required": ["goal_gates", "findings", "graph"],
      "properties": {
        "goal_gates": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0},
        "graph": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
