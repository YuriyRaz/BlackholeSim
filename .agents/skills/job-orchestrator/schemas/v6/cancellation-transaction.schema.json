{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recoverable cancellation transaction v6",
  "type": "object",
  "required": ["schema_version", "transaction_id", "run_id", "reason", "reason_digest", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "transaction_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "reason": {"type": "string", "minLength": 1},
    "reason_digest": {"$ref": "#/$defs/digest"},
    "status": {"type": "string", "enum": ["applying", "visible", "complete", "blocked"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
