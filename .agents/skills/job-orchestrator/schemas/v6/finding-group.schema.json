{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Group of related findings v6",
  "type": "object",
  "required": ["schema_version", "group_id", "finding_ids", "cycle_id", "relationship", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "group_id": {"$ref": "#/$defs/id"},
    "finding_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "cycle_id": {"$ref": "#/$defs/id"},
    "relationship": {"type": "string", "enum": ["causal", "correlated", "symptomatic", "duplicate"]},
    "description": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
