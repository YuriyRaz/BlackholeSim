{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic orchestration run v6",
  "type": "object",
  "required": ["schema_version", "protocol_revision", "run_id", "goal", "status", "job_ids", "created_at", "updated_at", "graph_revision", "graph_digest", "campaign_envelope_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "protocol_revision": {"type": "string", "const": "v6-closed"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "goal": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "completed", "failed", "cancelled"]},
    "job_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "expansion_ledger": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "graph_revision": {"type": "integer", "minimum": 1},
    "graph_digest": {"$ref": "#/$defs/digest"},
    "campaign_envelope_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
