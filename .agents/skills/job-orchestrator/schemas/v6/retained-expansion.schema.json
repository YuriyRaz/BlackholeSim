{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained expansion with provenance v6",
  "type": "object",
  "required": ["schema_version", "expansion_id", "plan_id", "campaign_id", "graph_revision", "jobs_added", "edges_added", "provenance", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "expansion_id": {"$ref": "#/$defs/id"},
    "plan_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "jobs_added": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "edges_added": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "provenance": {"$ref": "#/$defs/expansion_provenance"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "expansion_provenance": {
      "type": "object",
      "required": ["producer_job_id", "authority_id", "cycle_id"],
      "properties": {
        "producer_job_id": {"$ref": "#/$defs/id"},
        "authority_id": {"$ref": "#/$defs/id"},
        "cycle_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    }
  }
}
