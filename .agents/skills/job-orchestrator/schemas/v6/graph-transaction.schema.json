{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph transaction state v6",
  "type": "object",
  "required": ["schema_version", "transaction_id", "campaign_id", "graph_revision", "operation", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "transaction_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "operation": {"type": "string", "enum": ["expand", "repair", "prune", "redirect"]},
    "status": {"type": "string", "enum": ["pending", "applied", "rolled_back", "blocked"]},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
