{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic orchestration completion claim v6",
  "type": "object",
  "required": ["schema_version", "claim_id", "job_id", "run_id", "dispatch_id", "status", "target_gate_id", "target_gate_revision", "evidence_refs", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "claim_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "dispatch_id": {"$ref": "#/$defs/id"},
    "status": {"type": "string", "enum": ["success", "failure", "partial"]},
    "target_gate_id": {"$ref": "#/$defs/id"},
    "target_gate_revision": {"type": "integer", "minimum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"}, "uniqueItems": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
