{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic orchestration artifact v6",
  "type": "object",
  "required": ["schema_version", "artifact_id", "job_id", "run_id", "artifact_type", "digest", "source_artifact_digest", "authority_scope", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "artifact_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "artifact_type": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/digest"},
    "source_artifact_digest": {"$ref": "#/$defs/digest"},
    "authority_scope": {"$ref": "#/$defs/authority_scope_ref"},
    "path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "authority_scope_ref": {
      "type": "object",
      "required": ["authority_id", "scope"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/id"},
        "scope": {"type": "string", "enum": ["local", "campaign", "global"]}
      },
      "additionalProperties": false
    }
  }
}
