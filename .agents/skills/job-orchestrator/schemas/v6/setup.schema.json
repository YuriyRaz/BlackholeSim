{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic orchestration setup v6",
  "type": "object",
  "required": ["schema_version", "run_id", "request_path", "workspace", "execution_mode", "jobs", "graph_revision", "graph_generation_id", "campaign_envelope_id", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "request_path": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "execution_mode": {"type": "string", "enum": ["sequential", "parallel", "hybrid"]},
    "jobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/setup_job"}},
    "graph_revision": {"type": "integer", "minimum": 1},
    "graph_generation_id": {"$ref": "#/$defs/id"},
    "campaign_envelope_id": {"$ref": "#/$defs/id"},
    "adapter_binding": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "setup_job": {
      "type": "object",
      "required": ["job_id", "title", "prompt_path"],
      "properties": {
        "job_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "prompt_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
