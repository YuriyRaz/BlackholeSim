{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Append-only repair gate revision history v6",
  "type": "object",
  "required": ["schema_version", "history_id", "target_job_id", "revision", "repair_job_id", "status", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "history_id": {"$ref": "#/$defs/id"},
    "target_job_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "prior_revision": {"type": "integer", "minimum": 0},
    "repair_job_id": {"$ref": "#/$defs/id"},
    "finding_id": {"$ref": "#/$defs/id"},
    "finding_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "condition_id": {"$ref": "#/$defs/id"},
    "condition_result_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "verifier_assignment_id": {"$ref": "#/$defs/id"},
    "status": {"type": "string", "enum": ["pending", "applied", "rolled_back", "superseded"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"}, "uniqueItems": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
