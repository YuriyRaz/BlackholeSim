{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding with identity severity confidence evidence v6",
  "type": "object",
  "required": ["schema_version", "finding_id", "producer_job_id", "producer_role", "cycle_id", "severity", "confidence", "evidence", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "finding_id": {"$ref": "#/$defs/id"},
    "producer_job_id": {"$ref": "#/$defs/id"},
    "producer_role": {"type": "string", "minLength": 1},
    "cycle_id": {"$ref": "#/$defs/id"},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_entry"}, "uniqueItems": true},
    "description": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "evidence_entry": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
