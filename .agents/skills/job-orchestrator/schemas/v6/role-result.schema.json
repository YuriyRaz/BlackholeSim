{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative typed role result v6",
  "type": "object",
  "required": ["schema_version", "role_result_id", "role", "producer_job_id", "cycle_id", "response_id", "source_artifact_digest", "evidence_refs", "details", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "role_result_id": {"$ref": "#/$defs/id"},
    "role": {"type": "string", "enum": ["branch_initializer", "proposal_finalizer", "proposal_reviewer", "deterministic_check", "implementation_review_architect", "openspec_finalizer", "commit_worker", "push_worker", "remote_verifier"]},
    "producer_job_id": {"$ref": "#/$defs/id"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "response_id": {"$ref": "#/$defs/id"},
    "source_artifact_digest": {"$ref": "#/$defs/digest"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"}, "uniqueItems": true},
    "details": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
