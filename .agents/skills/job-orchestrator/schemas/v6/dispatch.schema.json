{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic orchestration dispatch v6",
  "type": "object",
  "required": ["schema_version", "dispatch_id", "job_id", "run_id", "graph_revision", "nonce", "work_units", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "dispatch_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "minLength": 1},
    "work_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work_unit"}},
    "bounds": {"$ref": "#/$defs/dispatch_bounds"},
    "checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "work_unit": {
      "type": "object",
      "required": ["unit_id", "unit_type"],
      "properties": {
        "unit_id": {"$ref": "#/$defs/id"},
        "unit_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "dispatch_bounds": {
      "type": "object",
      "required": ["max_retries", "timeout_seconds"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
