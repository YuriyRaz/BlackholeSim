{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job definition with role purpose graph authority v6",
  "type": "object",
  "required": ["schema_version", "job_id", "title", "prompt_path", "role", "purpose_key", "graph_generation", "expansion_origin", "authority_id", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "job_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "prompt_path": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "purpose_key": {"type": "string", "minLength": 1},
    "graph_generation": {"type": "integer", "minimum": 1},
    "expansion_origin": {"$ref": "#/$defs/id"},
    "authority_id": {"$ref": "#/$defs/id"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 10},
    "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "context_snapshot_id": {"type": "string"},
    "activation_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
