{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role definitions and contracts v6",
  "type": "object",
  "required": ["schema_version", "role_id", "role_name", "contract", "permissions", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "role_id": {"$ref": "#/$defs/id"},
    "role_name": {"type": "string", "minLength": 1},
    "contract": {"$ref": "#/$defs/role_contract"},
    "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "role_contract": {
      "type": "object",
      "required": ["input_types", "output_types", "deterministic"],
      "properties": {
        "input_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "output_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "deterministic": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
