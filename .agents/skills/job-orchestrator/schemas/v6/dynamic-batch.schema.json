{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic batch with open/sealed/complete/abandoned states v6",
  "type": "object",
  "required": ["schema_version", "batch_id", "campaign_id", "cycle_id", "status", "job_ids", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "batch_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "status": {"type": "string", "enum": ["open", "sealed", "complete", "abandoned"]},
    "job_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "sealed_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "abandoned_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
