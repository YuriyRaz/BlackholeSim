{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job activation record v6",
  "type": "object",
  "required": ["schema_version", "activation_id", "job_id", "run_id", "cycle_id", "graph_revision", "context_snapshot_id", "status", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "activation_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "context_snapshot_id": {"$ref": "#/$defs/id"},
    "status": {"type": "string", "enum": ["activated", "running", "completed", "failed", "cancelled"]},
    "activated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
