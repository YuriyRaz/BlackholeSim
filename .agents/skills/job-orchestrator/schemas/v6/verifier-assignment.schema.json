{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verifier assignment to target gate v6",
  "type": "object",
  "required": ["schema_version", "assignment_id", "target_job_id", "target_gate_revision", "verifier_job_id", "run_id", "cycle_id", "status", "assigned_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "assignment_id": {"$ref": "#/$defs/id"},
    "target_job_id": {"$ref": "#/$defs/id"},
    "target_gate_revision": {"type": "integer", "minimum": 1},
    "verifier_job_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "status": {"type": "string", "enum": ["assigned", "in_progress", "completed", "failed", "revoked"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"}, "uniqueItems": true},
    "required_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_artifact"}, "uniqueItems": true},
    "condition_id": {"$ref": "#/$defs/id"},
    "graph_generation": {"type": "integer", "minimum": 1},
    "source_snapshot_digest": {"$ref": "#/$defs/digest"},
    "assigned_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "evidence_artifact": {
      "type": "object",
      "required": ["artifact_ref", "artifact_digest"],
      "properties": {
        "artifact_ref": {"type": "string", "pattern": "run://[^/]+/(jobs|graph|campaign)/.+"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
