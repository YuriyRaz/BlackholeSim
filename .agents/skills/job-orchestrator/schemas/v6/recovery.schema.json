{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic orchestration recovery with expansion transaction v6",
  "type": "object",
  "required": ["schema_version", "recovery_id", "run_id", "job_id", "expansion_transaction_id", "strategy", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "recovery_id": {"$ref": "#/$defs/id"},
    "run_id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,127}"},
    "job_id": {"$ref": "#/$defs/id"},
    "expansion_transaction_id": {"$ref": "#/$defs/id"},
    "strategy": {"type": "string", "enum": ["retry", "reassign", "rollback_expand", "skip", "abort"]},
    "status": {"type": "string", "enum": ["pending", "in_progress", "completed", "failed"]},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
