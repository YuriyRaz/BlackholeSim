{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen campaign goal gate v6",
  "type": "object",
  "required": ["schema_version", "goal_gate_id", "gate_key", "context_snapshot_id", "module_id", "applies_to", "requirement", "evidence_requirements", "definition_digest", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "goal_gate_id": {"$ref": "#/$defs/id"},
    "gate_key": {"type": "string", "pattern": "[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}"},
    "context_snapshot_id": {"$ref": "#/$defs/id"},
    "module_id": {"type": "string", "pattern": "[a-z][a-z0-9._-]{0,127}"},
    "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requirement": {"type": "string", "minLength": 1},
    "evidence_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "definition_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"}
  }
}
