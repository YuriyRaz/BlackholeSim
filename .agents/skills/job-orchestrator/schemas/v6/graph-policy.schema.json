{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph policy and control v6",
  "type": "object",
  "required": ["schema_version", "policy_id", "campaign_id", "graph_revision", "limits", "constraints", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 6},
    "policy_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "limits": {"$ref": "#/$defs/graph_limits"},
    "constraints": {"$ref": "#/$defs/graph_constraints"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "[A-Z][A-Z0-9_-]{0,127}"},
    "digest": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "graph_limits": {
      "type": "object",
      "required": ["max_vertices", "max_edges", "max_expansion_depth"],
      "properties": {
        "max_vertices": {"type": "integer", "minimum": 1},
        "max_edges": {"type": "integer", "minimum": 1},
        "max_expansion_depth": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "graph_constraints": {
      "type": "object",
      "required": ["cycle_detection", "fan_out_limit"],
      "properties": {
        "cycle_detection": {"type": "string", "enum": ["strict", "warn"]},
        "fan_out_limit": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
