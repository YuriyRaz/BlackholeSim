{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker artifact attestation v5",
  "type": "object",
  "required": ["schema_version", "ref", "path", "kind", "producer_job_id", "attempt_id", "content_sha256", "accepted_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "ref": {"type": "string", "pattern": "run://[^/]+/jobs/[^/]+/[^/]+"},
    "path": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["report", "checkpoint", "evidence"]},
    "producer_job_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "response_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "content_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "accepted_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
