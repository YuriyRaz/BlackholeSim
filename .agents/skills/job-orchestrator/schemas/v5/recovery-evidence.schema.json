{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery evidence v5",
  "type": "object",
  "required": ["schema_version", "job_id", "observed_at", "classification", "transport", "recovery_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "job_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "classification": {"type": "string", "enum": ["active", "returned", "canceled", "lost", "unknown", "contradictory"]},
    "transport": {"type": "object"},
    "recovery_id": {"type": "string", "minLength": 1},
    "side_effect_check": {"type": "object"}
  },
  "additionalProperties": false
}
