{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completion condition result v5",
  "type": "object",
  "required": ["schema_version", "condition_id", "status", "verified_by"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "condition_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["passed", "failed", "not_run", "unavailable", "unknown"]},
    "verified_by": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "run://[^/]+/jobs/[^/]+/[^/]+"}},
    "summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
