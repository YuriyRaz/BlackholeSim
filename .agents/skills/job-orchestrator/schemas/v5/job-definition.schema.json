{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job registration definition v5",
  "type": "object",
  "required": ["schema_version", "jobs"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "jobs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "completion_conditions", "report_required", "side_effect_class"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "workflow": {"type": ["string", "null"], "minLength": 1},
          "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "context": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "escalation": {"type": "string", "minLength": 1},
          "completion_conditions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "report_required": {"type": "boolean"},
          "priority": {"type": "integer"},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "parent_job_id": {"type": ["string", "null"], "minLength": 1},
          "related_reports": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "side_effect_class": {"type": "string", "enum": ["none", "repository", "external_idempotent", "external_non_idempotent"]},
          "recovery_policy": {"type": ["object", "null"]},
          "verifier_for": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
