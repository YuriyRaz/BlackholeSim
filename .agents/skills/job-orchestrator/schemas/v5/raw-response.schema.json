{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable raw worker response v5",
  "type": "object",
  "required": ["schema_version", "response_id", "attempt_id", "response_sha256", "raw_response", "received_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "response_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "response_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "raw_response": {"type": "string"},
    "received_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
