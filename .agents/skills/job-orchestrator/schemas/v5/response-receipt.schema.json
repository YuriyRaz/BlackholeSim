{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adapter response receipt v5",
  "type": "object",
  "required": ["schema_version", "transport", "attempt_id", "native_session_ref", "run_id", "job_id", "response_id", "response_sha256", "raw_response", "received_at", "status", "proof"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "transport": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "native_session_ref": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "response_id": {"type": "string", "minLength": 1},
    "response_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "raw_response": {"type": "string"},
    "received_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["returned", "empty", "canceled", "lost", "unavailable", "unknown"]},
    "session_liveness": {"type": "string", "enum": ["live", "ended", "unknown", "unavailable"]},
    "proof": {"type": "object"}
  },
  "additionalProperties": false
}
