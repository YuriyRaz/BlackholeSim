{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adapter launch receipt v5",
  "type": "object",
  "required": ["schema_version", "transport", "dispatch_id", "native_session_ref", "run_id", "job_id", "prompt_sha256", "created_at", "proof"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "transport": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "native_session_ref": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "created_at": {"type": "string", "format": "date-time"},
    "proof": {"type": "object"}
  },
  "additionalProperties": false
}
