{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker session attempt v5",
  "type": "object",
  "required": ["schema_version", "attempt_id", "dispatch_id", "transport", "native_session_ref", "run_id", "job_id", "prompt_sha256", "status", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "attempt_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "transport": {"type": "string", "minLength": 1},
    "native_session_ref": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "status": {"type": "string", "enum": ["active", "returned", "canceled", "lost", "unknown", "replaced"]},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "recovery_id": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": false
}
