{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker dispatch v5",
  "type": "object",
  "required": ["schema_version", "dispatch_id", "run_id", "job_id", "kind", "prompt_ref", "prompt_path", "prompt_sha256", "status", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["start", "resume"]},
    "prompt_ref": {"type": "string", "pattern": "run://[^/]+/jobs/[^/]+/prompt"},
    "prompt_path": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "status": {"type": "string", "enum": ["pending", "delivered", "rejected"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
