{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative job state v5",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "prompt_path", "priority", "creation_sequence", "depends_on", "parent_job_id", "waiting_on", "report_required", "report_path", "checkpoint_path", "side_effect_class", "dispatches", "attempts", "active_attempt_id", "artifacts", "raw_responses", "outcome", "completion_claim", "created_at", "updated_at", "revision"],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["queued", "starting", "running", "completion_claimed", "waiting_for_input", "waiting_for_job", "recovering", "blocked", "repair_required", "completed", "failed", "canceled"]},
    "prompt_path": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "creation_sequence": {"type": "integer", "minimum": 1},
    "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "parent_job_id": {"type": ["string", "null"], "minLength": 1},
    "waiting_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "pending_question": {"type": ["object", "null"]},
    "answers": {"type": "array", "items": {"type": "object"}},
    "related_reports": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "report_required": {"type": "boolean"},
    "report_path": {"type": "string", "minLength": 1},
    "checkpoint_path": {"type": ["string", "null"], "minLength": 1},
    "side_effect_class": {"type": "string", "enum": ["none", "repository", "external_idempotent", "external_non_idempotent"]},
    "recovery_policy": {"type": ["object", "null"]},
    "dispatches": {"type": "array", "items": {"type": "object"}},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "active_attempt_id": {"type": ["string", "null"], "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "raw_responses": {"type": "array", "items": {"type": "object"}},
    "outcome": {"type": ["object", "null"]},
    "completion_claim": {"type": ["object", "null"]},
    "completion_conditions": {"type": "array", "items": {"type": "object"}},
    "pending_dispatch_id": {"type": ["string", "null"], "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
